# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Python
__pycache__/
*.py[cod]
/backend/venv
.ruff_cache/
.venv/

# Generated data
/backend/uploads
/backend/outputs

# Large generated sample output. The resampled CreditCard.csv is ~287 MB,
# which exceeds GitHub's 100 MB per-file push limit, so it is kept on disk
# but not committed. Regenerate it by running the backend on
# backend/uploads/CreditCard.csv.
/public/smote_resampled.csv
# The gzipped copy of the same file is ~98 MB, which is under the limit but
# still large enough to bloat every clone. It is ignored as well so a
# regenerated archive cannot accidentally be committed.
/public/smote_resampled.csv.gz
/public/weighted_*.csv
/public/smote_train.csv
/public/smote_test.csv

# Scratch space for one-off scripts and captured output. Nothing here is part
# of the project, and committing it previously broke the lint step.
/_scratch/
/*.html


# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
